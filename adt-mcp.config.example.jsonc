{
  "$schema": "./adt-mcp.schema.json",

  "server": {
    "name": "abap-adt-mcp-gateway",
    "logLevel": "info"
  },

  "defaultSystem": "dev",

  // Visibility only, not authorisation. `expose` picks one level — none | gateway |
  // readonly | write | low | high | full | core — and `allow` keeps only matching tools,
  // then `deny` removes matching ones. Clients hand the model a bounded list (some stop at
  // 128), so `core` is the practical shape: 124 curated tools plus the 3 Gateway* ones.
  // List levels and counts with: node tools/scripts/tool-presets.mjs
  "toolPolicy": {
    "timeoutMs": 180000,
    "expose": "core",
    "allow": [],
    "deny": []
  },

  "systems": [
    {
      "id": "dev",
      "label": "development client (writable)",
      "tier": "DEV",
      "endpoint": {
        "url": "https://sap.example.com:44300",
        "client": "100",
        "language": "ZH",
        "systemType": "onprem"
      },
      "auth": {
        "type": "basic",
        "username": "env:ADT_USER",
        "password": "keychain:abap-adt-mcp-gateway/dev"
      },
      "rfcBackend": "soap",
      "env": {}
    },
    {
      "id": "qa",
      "label": "quality client (read-only)",
      "tier": "QA",
      "endpoint": {
        "url": "https://sap.example.com:44300",
        "client": "200",
        "language": "ZH",
        "systemType": "onprem"
      },
      "auth": {
        "type": "basic",
        "username": "env:ADT_USER",
        "password": "keychain:abap-adt-mcp-gateway/qa"
      },
      "rfcBackend": "soap",
      "env": {}
    }
  ]
}
