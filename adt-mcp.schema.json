{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ABAP ADT MCP gateway configuration",
  "description": "Configuration for the abap-adt-mcp-gateway server. Credentials must be references (env:, file:, keychain:) — plain-text secrets are rejected at startup.",
  "$ref": "#/definitions/AbapAdtMcpConfig",
  "definitions": {
    "AbapAdtMcpConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "server": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "logLevel": {
              "type": "string",
              "enum": [
                "error",
                "warn",
                "info",
                "debug"
              ]
            }
          },
          "additionalProperties": false
        },
        "defaultSystem": {
          "type": "string"
        },
        "toolPolicy": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "readonly",
                  "write",
                  "low"
                ]
              }
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gateway": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
                "errorMessage": {
                  "pattern": "system id must be lowercase alphanumeric with . _ -"
                }
              },
              "label": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              },
              "endpoint": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "client": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "language": {
                    "type": "string"
                  },
                  "systemType": {
                    "type": "string",
                    "enum": [
                      "onprem",
                      "cloud"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "auth": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "basic",
                    "default": "basic"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "$ref": "#/definitions/AbapAdtMcpConfig/properties/systems/items/properties/auth/properties/username"
                  }
                },
                "additionalProperties": false
              },
              "rfcBackend": {
                "type": "string",
                "enum": [
                  "soap",
                  "odata"
                ]
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
